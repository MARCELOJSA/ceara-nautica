# ============================================================================
# Ceará Náutica — variáveis do site (apps/web)
# Copie para apps/web/.env e ajuste. NUNCA commite o .env.
# Itens vazios são OCULTADOS no site (nenhum dado é inventado).
# ============================================================================

# URL base da API. Padrão "/api" (o Vite faz proxy para a API em dev e preview).
VITE_API_URL=/api

# Destino do proxy do Vite (dev/preview). Não entra no bundle do navegador.
API_PROXY_TARGET=http://localhost:3333

# WhatsApp principal — SOMENTE dígitos, com DDI + DDD (ex.: 5592XXXXXXXXX).
# Vazio (padrão atual, a pedido do cliente): os botões de WhatsApp levam para
# /orcamento ou /contato e o Instagram aparece como canal de mensagem direta.
# Preenchido: botão flutuante e CTAs abrem wa.me com mensagem pré-preenchida.
VITE_WHATSAPP_NUMBER=

# Endereço completo (ex.: "Rua X, 123 — Bairro, Manaus – AM"). Vazio = não exibido.
VITE_ADDRESS=

# Horário de atendimento (ex.: "Seg. a sex., 8h às 18h"). Vazio = não exibido.
VITE_BUSINESS_HOURS=

# E-mail comercial. Vazio = não exibido.
VITE_CONTACT_EMAIL=

# Domínio de produção, sem barra final. Usado em canonical, Open Graph,
# sitemap.xml e robots.txt. OBRIGATÓRIO configurar antes de publicar.
VITE_SITE_URL=http://localhost:4173

# Marketing — carregados SOMENTE após consentimento no banner de cookies
# e somente se preenchidos. Ex.: GTM-XXXXXXX / G-XXXXXXXXXX / 123456789012345
VITE_GTM_ID=
VITE_GA4_ID=
VITE_META_PIXEL_ID=
