# =============================================================================
# API Ceará Náutica — variáveis de ambiente
# Copie para apps/api/.env e ajuste. NUNCA commite o arquivo .env.
# =============================================================================

# Ambiente: development | test | production
# Em production o handler de erros não devolve detalhes/stack trace.
NODE_ENV=development

# Porta HTTP da API
PORT=3333

# PostgreSQL (docker compose up -d db → porta host 5433)
DATABASE_URL="postgresql://cearanautica:cearanautica_dev@localhost:5433/cearanautica"

# Banco usado pelos testes automatizados (criado e migrado automaticamente
# por `npm run -w apps/api test`). Se vazio, usa DATABASE_URL trocando o nome
# do banco por "cearanautica_test". NUNCA aponte para o banco de produção.
TEST_DATABASE_URL="postgresql://cearanautica:cearanautica_dev@localhost:5433/cearanautica_test"

# Origens autorizadas no CORS (lista separada por vírgula, sem barra final).
# Padrão em desenvolvimento: http://localhost:5173,http://localhost:4173
# Em produção é OBRIGATÓRIA (ex.: https://www.dominio.com.br,https://dominio.com.br).
WEB_ORIGIN=http://localhost:5173,http://localhost:4173

# Número de proxies reversos à frente da API (ex.: 1 atrás de Nginx/Render/Railway).
# 0/false = não confia em X-Forwarded-For. Aceita também lista de IPs/sub-redes.
# "true" é recusado: deixaria qualquer cliente forjar o IP e contornar o rate limit.
TRUST_PROXY=0

# Rate limit dos POST (/api/contact, /api/quotes): N requisições por janela, por IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5
# true desliga o rate limit (uso em testes). Recusado em produção.
RATE_LIMIT_DISABLED=false

# Salt para o hash SHA-256 do IP dos leads (o IP cru nunca é gravado).
# Em produção é obrigatório, com pelo menos 16 caracteres: openssl rand -hex 32
IP_HASH_SALT=troque-este-valor

# Webhook opcional notificado a cada novo lead (POST JSON). Vazio = desligado.
# Ex.: URL de um fluxo Zapier/Make/n8n que envia e-mail ou mensagem à equipe.
# Falhas no webhook são apenas registradas no log e nunca quebram a requisição.
LEAD_WEBHOOK_URL=
# Tempo máximo de espera do webhook (ms)
LEAD_WEBHOOK_TIMEOUT_MS=5000

# Nível de log do pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Produção (Neon) — modelo; NÃO preencha este arquivo com dados reais.
# Defina estas variáveis no painel da hospedagem da API (nunca no repositório).
# -----------------------------------------------------------------------------
# Use a connection string DIRETA do Neon (host ep-xxxx.REGIAO.aws.neon.tech, SEM
# "-pooler"): a API é um único processo Node e o pooler não é necessário.
# - sslmode=require é OBRIGATÓRIO: em NODE_ENV=production a API recusa banco
#   remoto sem ele. Não use verify-ca/verify-full: o Prisma não os suporta e os
#   trata como "prefer" (sem TLS garantido). Para validar também o certificado,
#   acrescente &sslaccept=strict.
# - connect_timeout=15 dá tempo para o Neon religar o banco após inatividade.
# DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/neondb?sslmode=require&sslaccept=strict&connect_timeout=15"
#
# Obrigatórias em produção (a API não sobe sem elas):
# NODE_ENV=production
# WEB_ORIGIN=https://www.SEU-DOMINIO.com.br,https://SEU-DOMINIO.com.br
# IP_HASH_SALT=<saída de: openssl rand -hex 32>
# TRUST_PROXY=3   # nº de proxies à frente da API. Render: 3 (Cloudflare + 2 proxies do Render; ver render.yaml)
#
# Migrações e carga inicial do catálogo (com a DATABASE_URL acima no ambiente):
#   npm run -w apps/api db:deploy
#   npm run -w apps/api db:seed        # só na primeira vez
#
# Backup / restauração (requer Docker; pg_dump/pg_restore da imagem postgres:17-alpine):
#   npm run -w apps/api db:backup  -- [--url URL]           → apps/api/backups/<banco>-<data>.dump
#   npm run -w apps/api db:restore -- <arquivo> [--url URL] [--yes]   (--yes obrigatório se remoto)
# Os scripts nunca imprimem a senha, mas o npm ecoa a linha de comando: com URL real,
# prefira DATABASE_URL no ambiente em vez de --url, ou rode com "npm run -s".
# PG_TOOLS_IMAGE=postgres:17-alpine
